<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement class="screen">
        <ui:VisualElement class="content">
            <ui:VisualElement class="appbar">
                <ui:Button name="btn-back" text="‹  Back" class="iconbtn" />
                <ui:Label text="BANNER" class="badge" />
            </ui:VisualElement>

            <ui:VisualElement class="hero">
                <ui:VisualElement class="hero-accent accent-banner" />
                <ui:VisualElement class="hero-text">
                    <ui:Label text="Banner Ad" class="hero-title" />
                    <ui:Label text="Loads an anchored banner and refreshes it automatically." class="hero-desc" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Button name="btn-load" text="Load Banner Ad" class="btn btn-primary" />

            <ui:VisualElement class="status-card">
                <ui:Label text="STATUS" class="status-label" />
                <ui:VisualElement class="status-row">
                    <ui:VisualElement name="status-dot" class="status-dot dot--info" />
                    <ui:Label name="status" text="Idle — tap Load Banner Ad." class="status status--info" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:Label text="Leaving this screen removes the active banner." class="hint" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
