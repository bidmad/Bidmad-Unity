/* ============================================================
   Bidmad Sample - UI Toolkit design system (dark, modern)
   Only standard UI Toolkit USS properties are used.
   ============================================================ */

.screen {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: #0D1117;
    padding-top: 28px;
    padding-bottom: 28px;
    padding-left: 22px;
    padding-right: 22px;
    align-items: center;
}

/* Constrains content width on tablets/desktop while filling phones. */
.content {
    width: 100%;
    max-width: 560px;
    flex-grow: 1;
}

/* Vertically centre a short screen's content (used by the main menu). */
.content--centered {
    justify-content: center;
}

/* ---------- App bar ---------- */
.appbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 24px;
}

.brand {
    flex-direction: column;
}

.brand-mark {
    font-size: 26px;
    color: #F0F6FC;
    -unity-font-style: bold;
    letter-spacing: 3px;
}

.brand-sub {
    font-size: 12px;
    color: #8B949E;
    letter-spacing: 1px;
    margin-top: 2px;
}

.badge {
    font-size: 11px;
    color: #58A6FF;
    background-color: rgba(88, 166, 255, 0.12);
    border-color: rgba(88, 166, 255, 0.35);
    border-width: 1px;
    border-radius: 999px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 12px;
    padding-right: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

/* ---------- Section label ---------- */
.section-title {
    font-size: 12px;
    color: #8B949E;
    letter-spacing: 2px;
    -unity-font-style: bold;
    margin-bottom: 10px;
    margin-left: 4px;
}

/* ---------- Cards ---------- */
.card {
    width: 100%;
    background-color: #161B22;
    border-color: #30363D;
    border-width: 1px;
    border-radius: 16px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    padding-right: 8px;
    margin-bottom: 18px;
}

.hero {
    width: 100%;
    background-color: #161B22;
    border-color: #30363D;
    border-width: 1px;
    border-radius: 16px;
    padding-top: 22px;
    padding-bottom: 22px;
    padding-left: 22px;
    padding-right: 22px;
    margin-bottom: 18px;
    flex-direction: row;
    align-items: center;
}

.hero-accent {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    margin-right: 16px;
}

.hero-text {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
}

.hero-title {
    font-size: 22px;
    color: #F0F6FC;
    -unity-font-style: bold;
}

.hero-desc {
    font-size: 13px;
    color: #8B949E;
    margin-top: 4px;
    white-space: normal;
}

/* ---------- Navigation rows (main menu) ---------- */
.nav {
    flex-direction: row;
    align-items: center;
    height: 74px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 12px;
    padding-left: 14px;
    padding-right: 14px;
    margin-top: 2px;
    margin-bottom: 2px;
    transition-property: background-color;
    transition-duration: 0.12s;
}

.nav:hover {
    background-color: #1C2128;
}

.nav:active {
    background-color: #21262D;
}

.nav-accent {
    width: 12px;
    height: 40px;
    border-radius: 6px;
    margin-right: 16px;
}

.nav-text {
    flex-direction: column;
    flex-grow: 1;
    align-items: flex-start;
}

.nav-title {
    font-size: 18px;
    color: #E6EDF3;
    -unity-font-style: bold;
}

.nav-desc {
    font-size: 12px;
    color: #8B949E;
    margin-top: 3px;
}

.nav-chevron {
    font-size: 26px;
    color: #6E7681;
    -unity-text-align: middle-center;
}

.divider {
    height: 1px;
    background-color: #21262D;
    margin-left: 14px;
    margin-right: 14px;
}

/* ---------- Buttons ---------- */
.btn {
    height: 56px;
    border-radius: 12px;
    border-width: 0;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 6px;
    margin-bottom: 6px;
    transition-property: background-color, scale;
    transition-duration: 0.12s;
}

.btn-primary {
    background-color: #238636;
    color: #FFFFFF;
}

.btn-primary:hover {
    background-color: #2EA043;
}

.btn-primary:active {
    background-color: #1F7A32;
    scale: 0.99 0.99;
}

.btn-accent {
    background-color: #1F6FEB;
    color: #FFFFFF;
}

.btn-accent:hover {
    background-color: #2F81F7;
}

.btn-accent:active {
    background-color: #1A5FC8;
    scale: 0.99 0.99;
}

.btn-secondary {
    background-color: #21262D;
    color: #C9D1D9;
    border-color: #30363D;
    border-width: 1px;
}

.btn-secondary:hover {
    background-color: #282E36;
}

.btn-secondary:active {
    background-color: #2D333B;
    scale: 0.99 0.99;
}

/* Back button in the app bar */
.iconbtn {
    height: 40px;
    padding-left: 14px;
    padding-right: 16px;
    border-radius: 10px;
    border-width: 1px;
    border-color: #30363D;
    background-color: #161B22;
    color: #C9D1D9;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    transition-property: background-color;
    transition-duration: 0.12s;
}

.iconbtn:hover {
    background-color: #21262D;
}

/* ---------- Status panel ---------- */
.status-card {
    width: 100%;
    background-color: #0F141A;
    border-color: #21262D;
    border-width: 1px;
    border-radius: 14px;
    padding-top: 16px;
    padding-bottom: 16px;
    padding-left: 18px;
    padding-right: 18px;
    margin-top: 4px;
}

.status-label {
    font-size: 11px;
    color: #6E7681;
    letter-spacing: 2px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.status-row {
    flex-direction: row;
    align-items: center;
}

.status-dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    margin-right: 12px;
    background-color: #6E7681;
}

.status {
    font-size: 14px;
    color: #C9D1D9;
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
}

/* Status states drive the dot color via the sibling; we recolor the text too. */
.status--info {
    color: #C9D1D9;
}

.status--success {
    color: #56D364;
}

.status--error {
    color: #FF7B72;
}

.dot--info {
    background-color: #6E7681;
}

.dot--success {
    background-color: #3FB950;
}

.dot--error {
    background-color: #F85149;
}

/* ---------- Footer hint ---------- */
.hint {
    font-size: 11px;
    color: #565D66;
    -unity-text-align: middle-center;
    margin-top: 12px;
    white-space: normal;
}

/* ---------- Accent color helpers ---------- */
.accent-banner { background-color: #58A6FF; }
.accent-interstitial { background-color: #BC8CFF; }
.accent-reward { background-color: #3FB950; }
